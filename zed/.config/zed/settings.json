// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "language_models": {
    "opencode": {
      "show_zen_models": false
    }
  },
  "diff_view_style": "split",
  "ui_font_size": 14.0,
  "buffer_font_size": 14.0,
  "code_lens": "menu",
  "toolbar": {
    "code_actions": true,
  },
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "mode": "Sisyphus - ultraworker"
      },
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "model": "opus[1m]",
        "mode": "bypassPermissions",
        "effort": "high",
      },
      "type": "registry",
    },
    "codex-acp": {
      "favorite_config_option_values": {
        "fast-mode": ["off"],
      },
      "default_config_options": {
        "fast-mode": false,
        "model": "gpt-5.6-sol",
        "reasoning_effort": "medium",
        "mode": "agent-full-access",
      },
      "type": "registry",
    },
  },
  "agent": {
    "sandbox_permissions": {
      "network_hosts": [
        "registry.npmjs.org",
        "context7.com",
        "*.context7.com",
        "zed.dev",
        "opencode.ai",
        "raw.githubusercontent.com",
        "api.github.com"
      ]
    },
    "default_profile": "ask",
    "limit_content_width": true,
    "inline_assistant_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.6-luna",
      "enable_thinking": false,
    },
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow"
        },
        "skill": {
          "default": "allow"
        },
        "fetch": {
          "default": "allow",
        },
      },
    },
    "default_model": {
      "speed": "standard",
      "effort": "medium",
      "provider": "openai-subscribed",
      "model": "gpt-5.6-sol",
      "enable_thinking": true,
    },
    "flexible": true,
    "button": true,
    "max_content_width": 850.0,
    "default_height": 320.0,
    "default_width": 500.0,
    "dock": "right",
    "sidebar_side": "left",
    "favorite_models": [
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.6-sol",
        "enable_thinking": true,
        "effort": "medium",
        "speed": "standard"
      }
    ],
    "model_parameters": [],
  },
  "proxy": "",
  "bottom_dock_layout": "full",
  "cli_default_open_behavior": "existing_window",
  "soft_wrap": "prefer_line",
  "colorize_brackets": true,
  "confirm_quit": true,
  "context_servers": {
    },

  "line_indicator_format": "short",

  "git": {
    "branch_picker": {
      "show_author_name": true,
    },
    "hunk_style": "staged_hollow",
  },

  "vim_mode": true,
  "relative_line_numbers": "enabled",

  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
  },

  "ui_font_family": ".ZedMono",
  "buffer_font_family": ".ZedMono",

  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },

  "search": {
    "button": false,
  },

  "tab_bar": {
    "show_nav_history_buttons": false,
  },

  "terminal": {
    "font_family": ".ZedMono",
    "font_size": 14.0,
    "toolbar": {
      "breadcrumbs": false,
    },
    "default_height": 350.0,
  },

  "project_panel": {
    "dock": "left",
    "default_width": 350.0,
    "auto_fold_dirs": false,
  },

  "git_panel": {
    "group_by": "status",
    "tree_view": true,
    "status_style": "icon",
    "dock": "left",
    "default_width": 350.0,
  },

  "outline_panel": {
    "dock": "left",
    "default_width": 350.0,
  },

  "show_whitespaces": "trailing",
}
